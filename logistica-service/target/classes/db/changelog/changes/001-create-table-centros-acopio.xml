<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="001-create-table-centros-acopio" author="fabian">
        <createTable tableName="centros_acopio">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="nombre" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="direccion" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="comuna" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="capacidad_maxima" type="INT"><constraints nullable="false"/></column>
            <column name="responsable" type="VARCHAR(255)"/>
            <column name="telefono" type="VARCHAR(50)"/>
            <column name="activo" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="fecha_creacion" type="DATETIME"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
